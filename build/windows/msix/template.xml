<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="leanterm"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\LeanTerm">
    </Installer>
    <PackageInformation
        PackageName="LeanTerm"
        PackageDisplayName="LeanTerm"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.8.2.0"
        PackageDescription="LeanTerm Connection Manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="org.leanterm.app"
                Description="LeanTerm Connection Manager"
                DisplayName="LeanTerm"
                ExecutableName="leanterm"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LeanTerm</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>LeanTerm Connection Manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="leanterm.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
